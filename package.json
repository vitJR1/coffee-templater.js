{
  "name": "coffee-templater",
  "version": "0.1.0",
  "description": "Open-source templating engine for DOCX, XLSX and PPTX: variables, loops, conditions, filters, images, plus parsing documents to JSON and building them back.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "docx",
    "xlsx",
    "pptx",
    "template",
    "templating",
    "word",
    "excel",
    "powerpoint",
    "ooxml",
    "docxtemplater",
    "mail-merge"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  }
}
