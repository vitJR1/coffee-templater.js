{
  "name": "coffee-templater",
  "version": "0.1.0",
  "description": "Templating for DOCX, XLSX and PPTX (variables, loops, conditions, filters, images) and a JSON document model — powered by the coffee-templater-engine (Rust → WebAssembly).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "docx",
    "xlsx",
    "pptx",
    "template",
    "templating",
    "word",
    "excel",
    "powerpoint",
    "ooxml",
    "docxtemplater",
    "mail-merge",
    "wasm",
    "webassembly",
    "rust"
  ],
  "scripts": {
    "engine": "node scripts/fetch-engine.mjs",
    "pretest": "npm run engine --silent",
    "pretypecheck": "npm run engine --silent",
    "prebuild": "npm run engine --silent",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build:site": "npm run engine --silent && node scripts/build-site.mjs",
    "site": "npm run build:site --silent && npx --yes serve site -l 4173"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.27.7",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "vitest": "^5.1.0"
  },
  "coffeeEngine": {
    "repository": "vitJR1/coffee-templater-engine",
    "version": "0.1.0",
    "sha256": "134cace7305c5d113a3fb3b2f4bc22c4fdc58ffcd614c439944c36f9647533c8"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  }
}
